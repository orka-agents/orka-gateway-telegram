# Copy to .env for local development only. Keep every referenced secret file
# outside the repository and chmod it 0600. Set either NAME or NAME_FILE, never both.

LISTEN_ADDRESS=:8080
DATABASE_PATH=./data/telegram-adapter.db
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_URL=https://replace-me.example/telegram/webhook
TELEGRAM_DROP_PENDING_UPDATES=false
TELEGRAM_DISABLE_LINK_PREVIEWS=false

TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_WEBHOOK_SECRET_FILE=

# Use the chosen controller API and its existing harness-v2 watched namespace:
# http://127.0.0.1:8081/api/v1/gateways/<watch-namespace>/telegram/events
ORKA_GATEWAY_INGRESS_URL=
ORKA_GATEWAY_INBOUND_TOKEN_FILE=
ORKA_GATEWAY_OUTBOUND_TOKEN_FILE=

TELEGRAM_CONFORMANCE_CHAT_ID=0
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=20s
ADAPTER_VERSION=dev
